# Duplicate into .env.local. Values below are placeholders, not credentials.
NEXT_PUBLIC_DATA_MODE=local
FIREBASE_CONNECTION_ENABLED=false
FIREBASE_ANALYTICS_ENABLED=false
# Design placeholders; these do not gate the local text-pilot runtime.
PAID_OPERATIONS_ENABLED=false
AI_PROVIDER_MODE=mock

# Local text pilot: explicit provider/model, budget, call-count and time-window approval is required.
# Keep real credentials only in ignored .env.local; never add NEXT_PUBLIC_ to these names.
# Blank approval timestamps and secret intentionally keep a copied example inactive.
OPENAI_API_KEY=
READING_AI_PILOT_ENABLED=false
READING_AI_PILOT_APPROVED_AT=
READING_AI_PILOT_EXPIRES_AT=
# Generate a fresh 64-character lowercase hexadecimal secret only for an approved local pilot.
READING_AI_PILOT_SESSION_SECRET=

HOMEWORK_INTEGRATION_ENABLED=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
READING_ALLOWED_FIREBASE_PROJECT_ID=
READING_FIRESTORE_NAMESPACE=reading
